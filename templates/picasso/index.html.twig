{% extends 'base.html.twig' %}

{% block title %}PicassoBundle showcase{% endblock %}

{% block meta %}
    {# A plain transformed URL, for Open Graph: 1200x630 JPEG #}
    <meta property="og:image" content="{{ absolute_url(picasso_image_url(asset('build/images/jacalyn-beales-669247-unsplash.jpg'), width: 1200, height: 630, format: 'jpg', fit: 'cover')) }}">
{% endblock %}

{% block body %}
    <div class="container my-4">
        <div class="mb-5">
            <h1>PicassoBundle showcase</h1>
            <p class="lead">
                A live demo of the <a href="https://github.com/silarhi/picasso-bundle" target="_blank" rel="noopener">silarhi/picasso-bundle</a>
                Symfony package &mdash; the image component that was missing from the Symfony ecosystem.
            </p>
            <p>
                Every image below is rendered through the same Twig component: <code>&lt;twig:Picasso:Image&gt;</code>.
                The bundle takes care of generating a full <code>&lt;picture&gt;</code> element with AVIF and WebP sources,
                a JPEG fallback, responsive <code>srcset</code>, auto-detected dimensions and a blur placeholder inlined
                as a CSS <code>background-image</code>. Unfold <em>Show the Twig</em> under an example to see the code behind it.
            </p>
            <p class="mb-0">
                The transformer used in this project is <strong>Glide</strong> running locally with the GD driver,
                and signed URLs to prevent abuse. Transformed image variants are cached under
                <code>var/storage/picasso-cache/</code>.
            </p>
        </div>

        <nav class="mb-5" aria-label="Examples">
            <h2 class="h4">Examples</h2>
            <ol class="mb-0">
                <li><a href="#responsive-grid">Responsive grid with <code>sizes</code></a></li>
                <li><a href="#fit-modes">Different <code>fit</code> modes</a></li>
                <li><a href="#priority">Priority image (LCP)</a></li>
                <li><a href="#dimensions">Automatic dimensions</a></li>
                <li><a href="#fixed-size">Fixed size and pixel density</a></li>
                <li><a href="#placeholders">Placeholders</a></li>
                <li><a href="#twig-functions">Twig functions</a></li>
                <li><a href="#overrides">Individual overrides</a></li>
            </ol>
        </nav>

        <h2 id="responsive-grid">Responsive grid with <code>sizes</code></h2>
        <p>
            Three images laid out in a Bootstrap grid. The <code>sizes</code> attribute is forwarded to the component,
            and the <code>srcset</code> is generated automatically from the breakpoints configured in
            <code>picasso.yaml</code>.
        </p>
        <div class="row row-cols-1 row-cols-md-3">
            {% for image in [asset('build/images/destiny-wiens-1332880-unsplash.jpg'), asset('build/images/diana-parkhouse-1166627-unsplash.jpg'), asset('build/images/elvira-visser-k89j1SUqf5U-unsplash.jpg')] %}
                <div class="col">
                    <div class="card mb-3 shadow-sm">
                        <twig:Picasso:Image
                            src="{{ image }}"
                            width="600"
                            height="400"
                            sizes="(max-width: 768px) 100vw, 33vw"
                            fit="cover"
                            alt="A beautiful kitten"
                            class="card-img-top"
                        />
                        <div class="card-body">
                            <h5 class="card-title">Responsive grid</h5>
                            <p class="card-text">
                                One line of Twig, and you get a <code>&lt;picture&gt;</code> element
                                with every format and every size variant.
                            </p>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        <details class="mb-5">
            <summary class="text-secondary">Show the Twig</summary>
            <pre class="mt-2"><code>{% apply escape %}{% verbatim %}<twig:Picasso:Image
    src="{{ asset('build/images/destiny-wiens-1332880-unsplash.jpg') }}"
    width="600"
    height="400"
    sizes="(max-width: 768px) 100vw, 33vw"
    fit="cover"
    alt="A beautiful kitten"
    class="card-img-top"
/>{% endverbatim %}{% endapply %}</code></pre>
        </details>

        <h2 id="fit-modes">Different <code>fit</code> modes</h2>
        <p>
            The same source file rendered with three different cropping strategies.
        </p>
        <div class="row row-cols-1 row-cols-md-3">
            {% for fit in ['contain', 'cover', 'crop'] %}
                <div class="col mb-3 text-center">
                    <div class="bg-light p-3">
                        <twig:Picasso:Image
                            src="{{ asset('build/images/edgar-edgar-712801-unsplash.jpg') }}"
                            width="300"
                            height="300"
                            fit="{{ fit }}"
                            alt="300x300px, {{ fit }}"
                            class="img-fluid d-block mx-auto shadow-sm"
                        />
                    </div>
                    <span class="text-muted small">300x300px, <code>fit="{{ fit }}"</code></span>
                </div>
            {% endfor %}
        </div>
        <details class="mb-5">
            <summary class="text-secondary">Show the Twig</summary>
            <pre class="mt-2"><code>{% apply escape %}{% verbatim %}<twig:Picasso:Image
    src="{{ asset('build/images/edgar-edgar-712801-unsplash.jpg') }}"
    width="300"
    height="300"
    fit="contain" {# or "cover", "crop", "fill" #}
    alt="300x300px, contain"
/>{% endverbatim %}{% endapply %}</code></pre>
        </details>

        <h2 id="priority">Priority image (LCP)</h2>
        <p>
            With <code>:priority="true"</code>, the image is loaded with <code>loading="eager"</code> and
            <code>fetchpriority="high"</code>. The blur placeholder is automatically disabled since it would
            only slow down the first paint. This is the mode you want for a hero banner.
        </p>
        <twig:Picasso:Image
            src="{{ asset('build/images/jacalyn-beales-669247-unsplash.jpg') }}"
            width="1200"
            height="500"
            sizes="100vw"
            fit="cover"
            :priority="true"
            alt="Hero banner"
            class="img-fluid w-100 rounded shadow"
        />
        <details class="mt-3 mb-5">
            <summary class="text-secondary">Show the Twig</summary>
            <pre class="mt-2"><code>{% apply escape %}{% verbatim %}<twig:Picasso:Image
    src="{{ asset('build/images/jacalyn-beales-669247-unsplash.jpg') }}"
    width="1200"
    height="500"
    sizes="100vw"
    fit="cover"
    :priority="true"
    alt="Hero banner"
/>{% endverbatim %}{% endapply %}</code></pre>
        </details>

        <h2 id="dimensions">Automatic dimensions</h2>
        <p>
            The <code>width</code> and <code>height</code> attributes tell the browser the shape of the image before
            it loads, so the layout does not jump (<abbr title="Cumulative Layout Shift">CLS</abbr>). The filesystem
            loader reads them from the source file (<code>resolve_metadata</code>, cached), so you only pass what
            you know. The values below are read from the rendered HTML.
        </p>
        {% set dimensionExamples = [
            {title: 'No dimension at all', caption: 'the source dimensions are used'},
            {title: 'Width only', caption: 'the height follows the source aspect ratio'},
            {title: 'Known source dimensions', caption: 'given explicitly, the file is not read'},
        ] %}
        <div class="row row-cols-1 row-cols-md-3">
            {% for example in dimensionExamples %}
                {% set markup %}
                    {% if loop.index == 1 %}
                        <twig:Picasso:Image
                            src="{{ asset('build/images/destiny-wiens-1332880-unsplash.jpg') }}"
                            sizes="(max-width: 768px) 100vw, 33vw"
                            alt="Dimensions detected from the source"
                            class="img-fluid shadow-sm"
                        />
                    {% elseif loop.index == 2 %}
                        <twig:Picasso:Image
                            src="{{ asset('build/images/destiny-wiens-1332880-unsplash.jpg') }}"
                            width="400"
                            sizes="(max-width: 768px) 100vw, 33vw"
                            alt="Height computed from the width"
                            class="img-fluid shadow-sm"
                        />
                    {% else %}
                        <twig:Picasso:Image
                            src="{{ asset('build/images/destiny-wiens-1332880-unsplash.jpg') }}"
                            :sourceWidth="1800"
                            :sourceHeight="1198"
                            width="400"
                            sizes="(max-width: 768px) 100vw, 33vw"
                            alt="Explicit source dimensions"
                            class="img-fluid shadow-sm"
                        />
                    {% endif %}
                {% endset %}
                <div class="col mb-3">
                    <h5>{{ example.title }}</h5>
                    {{ markup }}
                    <p class="text-muted small mt-2 mb-0">
                        Rendered <code>width="{{ markup|split('<img')|last|split(' width="')[1]|split('"')|first }}" height="{{ markup|split('<img')|last|split(' height="')[1]|split('"')|first }}"</code>:
                        {{ example.caption }}.
                    </p>
                </div>
            {% endfor %}
        </div>
        <details class="mb-5">
            <summary class="text-secondary">Show the Twig</summary>
            <pre class="mt-2"><code>{% apply escape %}{% verbatim %}{# No dimension at all: the source dimensions are used #}
<twig:Picasso:Image src="..." sizes="(max-width: 768px) 100vw, 33vw" alt="..." />

{# Width only: the height follows the source aspect ratio #}
<twig:Picasso:Image src="..." width="400" sizes="(max-width: 768px) 100vw, 33vw" alt="..." />

{# Known source dimensions: the file is not read #}
<twig:Picasso:Image src="..." :sourceWidth="1800" :sourceHeight="1198" width="400" sizes="(max-width: 768px) 100vw, 33vw" alt="..." />{% endverbatim %}{% endapply %}</code></pre>
        </details>

        <h2 id="fixed-size">Fixed size and pixel density</h2>
        <p>
            Without <code>sizes</code>, the image is meant to be shown at a fixed size: the <code>srcset</code> uses
            pixel density descriptors instead of widths, so a retina screen gets the 2x variant. Ideal for avatars,
            logos and thumbnails.
        </p>
        {% set avatars %}
            {% for image in ['destiny-wiens-1332880-unsplash.jpg', 'diana-parkhouse-1166627-unsplash.jpg', 'elvira-visser-k89j1SUqf5U-unsplash.jpg'] %}
                <twig:Picasso:Image
                    src="{{ asset('build/images/' ~ image) }}"
                    width="96"
                    height="96"
                    fit="cover"
                    alt="Avatar {{ loop.index }}"
                    class="rounded-circle shadow-sm me-2"
                />
            {% endfor %}
        {% endset %}
        <div class="d-flex align-items-center flex-wrap">
            {{ avatars }}
            <span class="text-muted small">
                <code>srcset</code> descriptors:
                {% for candidate in avatars|split('<img')|last|split(' srcset="')[1]|split('"')|first|split(', ') %}
                    <code>{{ candidate|split(' ')|last }}</code>{{ not loop.last ? ',' }}
                {% endfor %}
            </span>
        </div>
        <details class="mt-3 mb-5">
            <summary class="text-secondary">Show the Twig</summary>
            <pre class="mt-2"><code>{% apply escape %}{% verbatim %}<twig:Picasso:Image
    src="{{ asset('build/images/destiny-wiens-1332880-unsplash.jpg') }}"
    width="96"
    height="96"
    fit="cover"
    alt="Avatar"
    class="rounded-circle"
/>{% endverbatim %}{% endapply %}</code></pre>
        </details>

        <h2 id="placeholders">Placeholders</h2>
        <p>
            While the photo loads, a placeholder fills its box: it is inlined as a CSS <code>background-image</code>
            on the <code>&lt;img&gt;</code> and removed once the photo is there. Below is what each strategy shows,
            for the same 600x400 photo (throttle your network in the dev tools to see them live).
        </p>
        {% set placeholderStrategies = [
            {
                key: 'blur',
                title: 'Blurred thumbnail (LQIP)',
                twig: 'placeholder="blur"',
                caption: 'A 10x7 JPEG blurred by the transformer. The default here, no extra dependency.',
            },
            {
                key: 'blurhash',
                title: 'BlurHash',
                twig: 'placeholder="blurhash"',
                caption: 'A smooth gradient decoded from a BlurHash, inlined as a PNG data URI.',
            },
            {
                key: 'placeholderData',
                title: 'Your own data URI',
                twig: 'placeholderData="data:image/svg+xml,…"',
                caption: 'Any data URI you already have, e.g. a dominant color stored with the image.',
            },
            {
                key: 'none',
                title: 'No placeholder',
                twig: ':placeholder="false"',
                caption: 'Nothing until the photo loads: the box only reserves its space.',
            },
        ] %}
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4">
            {% for strategy in placeholderStrategies %}
                {% set uri = placeholders[strategy.key] ?? null %}
                <div class="col mb-3">
                    <div class="card h-100 shadow-sm">
                        {% if uri %}
                            <div class="card-img-top" style="aspect-ratio: 3 / 2; background: center / cover no-repeat url({{ uri|json_encode }})"></div>
                        {% else %}
                            <div class="card-img-top bg-light" style="aspect-ratio: 3 / 2"></div>
                        {% endif %}
                        <div class="card-body">
                            <h5 class="card-title">{{ strategy.title }}</h5>
                            <p class="card-text small mb-2"><code>{{ strategy.twig }}</code></p>
                            <p class="card-text small text-muted mb-0">
                                {{ strategy.caption }}
                                {% if uri starts with 'data:' %}
                                    {{ uri|length|number_format(0, '.', ' ') }} bytes inline.
                                {% endif %}
                            </p>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        <details class="mb-5">
            <summary class="text-secondary">Show the Twig and the configuration</summary>
            <pre class="mt-2"><code>{% apply escape %}{% verbatim %}<twig:Picasso:Image src="..." width="600" height="400" fit="cover" alt="..." /> {# default_placeholder: blur #}
<twig:Picasso:Image src="..." width="600" height="400" fit="cover" placeholder="blurhash" alt="..." />
<twig:Picasso:Image src="..." width="600" height="400" fit="cover" placeholderData="data:image/svg+xml,..." alt="..." />
<twig:Picasso:Image src="..." width="600" height="400" fit="cover" :placeholder="false" alt="..." />{% endverbatim %}{% endapply %}</code></pre>
            <pre><code># config/packages/picasso.yaml
picasso:
    placeholders:
        blur:
            type: transformer
            size: 10
            blur: 5
            quality: 30
        blurhash:
            type: blurhash
            driver: gd
    default_placeholder: blur</code></pre>
        </details>

        <h2 id="twig-functions">Twig functions</h2>
        <p>
            The component is not the only way in. <code>picasso_image()</code> renders the same
            <code>&lt;picture&gt;</code> for projects without <code>symfony/ux-twig-component</code>, and
            <code>picasso_image_url()</code> returns a single transformed URL, for anything that is not an
            <code>&lt;img&gt;</code>: a CSS background, an Open Graph image, an email.
        </p>
        <div class="row row-cols-1 row-cols-md-2">
            <div class="col mb-3">
                <h5><code>picasso_image()</code></h5>
                {{ picasso_image(
                    src: asset('build/images/elvira-visser-k89j1SUqf5U-unsplash.jpg'),
                    width: 600,
                    height: 400,
                    sizes: '(max-width: 768px) 100vw, 50vw',
                    fit: 'cover',
                    attributes: {alt: 'Rendered by picasso_image()', class: 'img-fluid rounded shadow-sm'},
                ) }}
            </div>
            <div class="col mb-3">
                <h5><code>picasso_image_url()</code> as a CSS background</h5>
                <div class="rounded shadow-sm d-flex align-items-end p-4" style="aspect-ratio: 3 / 2; background: linear-gradient(to top, rgb(0 0 0 / 0.65), transparent 55%), center / cover no-repeat url({{ picasso_image_url(asset('build/images/elvira-visser-k89j1SUqf5U-unsplash.jpg'), width: 1200, height: 800, format: 'webp', quality: 80, fit: 'cover')|json_encode }})">
                    <span class="h3 mb-0 text-white">Text over a transformed background</span>
                </div>
            </div>
        </div>
        <p class="text-muted small">
            This page's <code>og:image</code> also comes from <code>picasso_image_url()</code>: a 1200x630 JPEG,
            the size social networks expect.
        </p>
        <details class="mb-5">
            <summary class="text-secondary">Show the Twig</summary>
            <pre class="mt-2"><code>{% apply escape %}{% verbatim %}{{ picasso_image(
    src=asset('build/images/elvira-visser-k89j1SUqf5U-unsplash.jpg'),
    width=600,
    height=400,
    sizes='(max-width: 768px) 100vw, 50vw',
    fit='cover',
    attributes={alt: 'Rendered by picasso_image()', class: 'img-fluid rounded'}
) }}

<div style="background-image: url('{{ picasso_image_url('photo.jpg', width: 1200, height: 800, format: 'webp', quality: 80, fit: 'cover') }}')">

<meta property="og:image" content="{{ absolute_url(picasso_image_url('photo.jpg', width: 1200, height: 630, format: 'jpg', fit: 'cover')) }}">{% endverbatim %}{% endapply %}</code></pre>
        </details>

        <h2 id="overrides">Individual overrides</h2>
        <p>
            Two examples showing per-image overrides: a custom quality setting on the left, and an image
            with its blur placeholder explicitly disabled on the right.
        </p>
        <div class="row row-cols-1 row-cols-md-2">
            <div class="col mb-3">
                <h5>Quality set to 40% (<code>:quality="40"</code>)</h5>
                <twig:Picasso:Image
                    src="{{ asset('build/images/diana-parkhouse-1166627-unsplash.jpg') }}"
                    width="600"
                    height="400"
                    :quality="40"
                    fit="cover"
                    alt="Low quality"
                    class="img-fluid shadow-sm"
                />
            </div>
            <div class="col mb-3">
                <h5>No placeholder (<code>:placeholder="false"</code>)</h5>
                <twig:Picasso:Image
                    src="{{ asset('build/images/diana-parkhouse-1166627-unsplash.jpg') }}"
                    width="600"
                    height="400"
                    :placeholder="false"
                    fit="cover"
                    alt="No placeholder"
                    class="img-fluid shadow-sm"
                />
            </div>
        </div>
        <details class="mb-5">
            <summary class="text-secondary">Show the Twig</summary>
            <pre class="mt-2"><code>{% apply escape %}{% verbatim %}<twig:Picasso:Image src="..." width="600" height="400" fit="cover" :quality="40" alt="Low quality" />

<twig:Picasso:Image src="..." width="600" height="400" fit="cover" :placeholder="false" alt="No placeholder" />{% endverbatim %}{% endapply %}</code></pre>
        </details>

        <div class="alert alert-info">
            <strong>See also:</strong> the legacy version of this page, which uses Glide directly
            (no PicassoBundle on top), is still available at <a href="{{ path('images') }}">/images</a>.
            Handy for comparing how much Twig code you actually need between the two approaches.
        </div>
    </div>
{% endblock %}
