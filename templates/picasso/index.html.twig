{% extends 'base.html.twig' %}

{% import 'picasso/macros.html.twig' as picasso %}

{% block title %}PicassoBundle showcase{% endblock %}

{% block meta %}
    {# A plain transformed URL, for Open Graph: 1200x630 JPEG #}
    <meta property="og:image" content="{{ absolute_url(picasso_image_url(asset('build/images/jacalyn-beales-669247-unsplash.jpg'), width: 1200, height: 630, format: 'jpg', fit: 'cover')) }}">
{% endblock %}

{% block body %}
    <div class="container my-4 docs">
        <twig:StatusBar label="Glide" class="mb-3">
            <twig:StatusBar:Item label="Driver">GD</twig:StatusBar:Item>
            <twig:StatusBar:Item label="URLs">signed</twig:StatusBar:Item>
            <twig:StatusBar:Item label="Cache">var/storage/picasso-cache/</twig:StatusBar:Item>
        </twig:StatusBar>
        <twig:PageHero eyebrow="silarhi/picasso-bundle" title="PicassoBundle showcase" class="mb-4">
            <twig:PageHero:Lead>
                The image component that was missing from the Symfony ecosystem. Every image below is rendered by the
                same Twig component, <code>&lt;twig:Picasso:Image&gt;</code>: switch any example to <em>Code</em> to see
                the Twig behind it.
            </twig:PageHero:Lead>
            <twig:PageHero:Features>
                <twig:PageHero:Feature>A <code>&lt;picture&gt;</code> with AVIF and WebP sources</twig:PageHero:Feature>
                <twig:PageHero:Feature>A JPEG fallback</twig:PageHero:Feature>
                <twig:PageHero:Feature>A responsive <code>srcset</code></twig:PageHero:Feature>
                <twig:PageHero:Feature>Auto-detected dimensions</twig:PageHero:Feature>
                <twig:PageHero:Feature>A blur placeholder, inlined in the CSS</twig:PageHero:Feature>
            </twig:PageHero:Features>
            <twig:PageHero:Actions>
                <a class="btn btn-primary" href="https://github.com/silarhi/picasso-bundle" target="_blank" rel="noopener">
                    silarhi/picasso-bundle {{ ux_icon('lucide:external-link', {class: 'ms-1'}) }}
                </a>
                <a class="btn" href="https://blog.silarhi.fr/presentation-picasso-bundle-symfony-image/" target="_blank" rel="noopener">
                    Why and how it was built (in French) {{ ux_icon('lucide:external-link', {class: 'ms-1'}) }}
                </a>
            </twig:PageHero:Actions>
        </twig:PageHero>

        <twig:Toc title="Examples" class="mb-5">
            <twig:Toc:Item href="#responsive-grid" hint="sizes">Responsive grid</twig:Toc:Item>
            <twig:Toc:Item href="#fit-modes" hint="fit">Different fit modes</twig:Toc:Item>
            <twig:Toc:Item href="#priority" hint="priority">Priority image (LCP)</twig:Toc:Item>
            <twig:Toc:Item href="#dimensions" hint="width, height">Automatic dimensions</twig:Toc:Item>
            <twig:Toc:Item href="#fixed-size" hint="srcset 1x, 2x">Fixed size and pixel density</twig:Toc:Item>
            <twig:Toc:Item href="#placeholders" hint="placeholder">Placeholders</twig:Toc:Item>
            <twig:Toc:Item href="#twig-functions" hint="picasso_image_url()">Twig functions</twig:Toc:Item>
            <twig:Toc:Item href="#json-api" hint="imageData()">JSON API for headless frontends</twig:Toc:Item>
            <twig:Toc:Item href="#overrides" hint="quality, unoptimized">Individual overrides</twig:Toc:Item>
            <twig:Toc:Item href="#generated-html" hint="picture">What the component generates</twig:Toc:Item>
        </twig:Toc>

        <h2 id="responsive-grid">Responsive grid with <code>sizes</code></h2>
        <p>
            Three images laid out in a Bootstrap grid. The <code>sizes</code> attribute is forwarded to the component,
            and the <code>srcset</code> is generated automatically from the breakpoints configured in
            <code>picasso.yaml</code>.
        </p>
        <div class="row row-cols-1 row-cols-md-3 mb-4">
            {% for image in ['destiny-wiens-1332880-unsplash.jpg', 'diana-parkhouse-1166627-unsplash.jpg', 'elvira-visser-k89j1SUqf5U-unsplash.jpg'] %}
                {% set props = {width: 600, height: 400, sizes: '(max-width: 768px) 100vw, 33vw', fit: 'cover', alt: 'A beautiful kitten', class: 'd-block w-100'} %}
                <div class="col mb-3 d-flex flex-column">
                    {% set markup = picasso.image(image, props) %}
                    {% set code = picasso.snippet(image, props) %}
                    <twig:Showcase class="flex-grow-1" meta="sizes: 33vw">
                        {{ markup }}
                        <twig:Showcase:Caption title="Responsive grid">
                            One line of Twig, and you get a <code>&lt;picture&gt;</code> element
                            with every format and every size variant.
                        </twig:Showcase:Caption>
                        <twig:block name="code">{{ code }}</twig:block>
                    </twig:Showcase>
                </div>
            {% endfor %}
        </div>

        <h2 id="fit-modes">Different <code>fit</code> modes</h2>
        <p>
            The same source file rendered with three different cropping strategies.
        </p>
        <div class="row row-cols-1 row-cols-md-3 mb-4">
            {% for fit in ['contain', 'cover', 'crop'] %}
                {% set props = {width: 300, height: 300, fit: fit, alt: '300x300px, ' ~ fit, class: 'img-fluid d-block mx-auto shadow-sm'} %}
                <div class="col mb-3 d-flex flex-column">
                    {% set markup = picasso.image('edgar-edgar-712801-unsplash.jpg', props) %}
                    {% set code = picasso.snippet('edgar-edgar-712801-unsplash.jpg', props) %}
                    <twig:Showcase class="flex-grow-1" meta="fit: {{ fit }}">
                        <div class="card-body bg-light text-center">
                            {{ markup }}
                        </div>
                        <twig:Showcase:Caption class="border-top">300x300px, fit="{{ fit }}"</twig:Showcase:Caption>
                        <twig:block name="code">{{ code }}</twig:block>
                    </twig:Showcase>
                </div>
            {% endfor %}
        </div>

        <h2 id="priority">Priority image (LCP)</h2>
        <p>
            With <code>:priority="true"</code>, the image is loaded with <code>loading="eager"</code> and
            <code>fetchpriority="high"</code>. The blur placeholder is automatically disabled since it would
            only slow down the first paint. This is the mode you want for a hero banner.
        </p>
        {% set props = {width: 1200, height: 500, sizes: '100vw', fit: 'cover', priority: true, alt: 'Hero banner', class: 'd-block w-100'} %}
        {% set markup = picasso.image('jacalyn-beales-669247-unsplash.jpg', props) %}
        {% set code = picasso.snippet('jacalyn-beales-669247-unsplash.jpg', props) %}
        <twig:Showcase class="mb-5" meta='fetchpriority="high" · loading="eager"'>
            <div class="position-relative">
                {{ markup }}
                <span class="tag-mono tag-overlay tag-overlay-bottom">Hero banner · LCP</span>
            </div>
            <twig:block name="code">{{ code }}</twig:block>
        </twig:Showcase>

        <h2 id="dimensions">Automatic dimensions</h2>
        <p>
            The <code>width</code> and <code>height</code> attributes tell the browser the shape of the image before
            it loads, so the layout does not jump (<abbr title="Cumulative Layout Shift">CLS</abbr>). The filesystem
            loader reads them from the source file (<code>resolve_metadata</code>, cached), so you only pass what
            you know. The values below are read from the rendered HTML.
        </p>
        {% set dimensionExamples = [
            {
                title: 'No dimension at all',
                caption: 'the source dimensions are used',
                props: {sizes: '(max-width: 768px) 100vw, 33vw', alt: 'Dimensions detected from the source', class: 'img-fluid shadow-sm'},
            },
            {
                title: 'Width only',
                caption: 'the height follows the source aspect ratio',
                props: {width: 400, sizes: '(max-width: 768px) 100vw, 33vw', alt: 'Height computed from the width', class: 'img-fluid shadow-sm'},
            },
            {
                title: 'Known source dimensions',
                caption: 'given explicitly, the file is not read',
                props: {sourceWidth: 1800, sourceHeight: 1198, width: 400, sizes: '(max-width: 768px) 100vw, 33vw', alt: 'Explicit source dimensions', class: 'img-fluid shadow-sm'},
            },
        ] %}
        <div class="row row-cols-1 row-cols-md-3 mb-4">
            {% for example in dimensionExamples %}
                {% set markup = picasso.image('destiny-wiens-1332880-unsplash.jpg', example.props) %}
                {% set renderedImg = markup|split('<img')|last %}
                <div class="col mb-3 d-flex flex-column">
                    {% set code = picasso.snippet('destiny-wiens-1332880-unsplash.jpg', example.props) %}
                    <twig:Showcase class="flex-grow-1">
                        {{ markup }}
                        <twig:Showcase:Caption title="{{ example.title }}">
                            Rendered <code>width="{{ renderedImg|split(' width="')[1]|split('"')|first }}" height="{{ renderedImg|split(' height="')[1]|split('"')|first }}"</code>:
                            {{ example.caption }}.
                        </twig:Showcase:Caption>
                        <twig:block name="code">{{ code }}</twig:block>
                    </twig:Showcase>
                </div>
            {% endfor %}
        </div>

        <h2 id="fixed-size">Fixed size and pixel density</h2>
        <p>
            Without <code>sizes</code>, the image is meant to be shown at a fixed size: the <code>srcset</code> uses
            pixel density descriptors instead of widths, so a retina screen gets the 2x variant. Ideal for avatars,
            logos and thumbnails.
        </p>
        <div class="row row-cols-1 row-cols-md-3 mb-4">
            {% for image in ['destiny-wiens-1332880-unsplash.jpg', 'diana-parkhouse-1166627-unsplash.jpg', 'elvira-visser-k89j1SUqf5U-unsplash.jpg'] %}
                {% set props = {width: 96, height: 96, fit: 'cover', alt: 'Avatar ' ~ loop.index, class: 'rounded-circle shadow-sm'} %}
                {% set markup = picasso.image(image, props) %}
                <div class="col mb-3 d-flex flex-column">
                    {% set code = picasso.snippet(image, props) %}
                    <twig:Showcase class="flex-grow-1" meta="96x96">
                        <div class="card-body d-flex align-items-center">
                            {{ markup }}
                            <span class="text-secondary small ms-3">
                                <code>srcset</code>:
                                {% for candidate in markup|split('<img')|last|split(' srcset="')[1]|split('"')|first|split(', ') %}
                                    <code>{{ candidate|split(' ')|last }}</code>{{ not loop.last ? ',' }}
                                {% endfor %}
                            </span>
                        </div>
                        <twig:block name="code">{{ code }}</twig:block>
                    </twig:Showcase>
                </div>
            {% endfor %}
        </div>

        <h2 id="placeholders">Placeholders</h2>
        <p>
            While the photo loads, a placeholder fills its box: it is inlined as a CSS <code>background-image</code>
            on the <code>&lt;img&gt;</code> and removed once the photo is there. Below is what each strategy shows,
            for the same 600x400 photo (throttle your network in the dev tools to see them live).
        </p>
        {% set placeholderStrategies = [
            {
                key: 'blur',
                title: 'Blurred thumbnail (LQIP)',
                props: {placeholder: 'blur'},
                caption: 'A 10x7 JPEG blurred by the transformer. The default here, no extra dependency.',
            },
            {
                key: 'blurhash',
                title: 'BlurHash',
                props: {placeholder: 'blurhash'},
                caption: 'A smooth gradient decoded from a BlurHash, inlined as a PNG data URI.',
            },
            {
                key: 'placeholderData',
                title: 'Your own data URI',
                props: {placeholderData: 'data:image/svg+xml,…'},
                caption: 'Any data URI you already have, e.g. a dominant color stored with the image.',
            },
            {
                key: 'none',
                title: 'No placeholder',
                props: {placeholder: false},
                caption: 'Nothing until the photo loads: the box only reserves its space.',
            },
        ] %}
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4">
            {% for strategy in placeholderStrategies %}
                {% set uri = placeholders[strategy.key] ?? null %}
                <div class="col mb-3 d-flex flex-column">
                    {% set code = picasso.snippet('diana-parkhouse-1166627-unsplash.jpg', {width: 600, height: 400, fit: 'cover'}|merge(strategy.props)) %}
                    <twig:Showcase class="flex-grow-1" meta="{{ strategy.key == 'placeholderData' ? 'data URI' : strategy.key }}">
                        {% if uri %}
                            <div style="aspect-ratio: 3 / 2; background: center / cover no-repeat url({{ uri|json_encode }})"></div>
                        {% else %}
                            <div class="bg-light" style="aspect-ratio: 3 / 2"></div>
                        {% endif %}
                        <twig:Showcase:Caption title="{{ strategy.title }}">
                            {{ strategy.caption }}
                            {% if uri starts with 'data:' %}
                                {{ uri|length|number_format(0, '.', ' ') }} bytes inline.
                            {% endif %}
                        </twig:Showcase:Caption>
                        <twig:block name="code">{{ code }}</twig:block>
                    </twig:Showcase>
                </div>
            {% endfor %}
        </div>
        <details class="mb-5">
            <summary class="text-secondary">Show the configuration</summary>
            <twig:CodePanel title="config/packages/picasso.yaml" meta="YAML" class="mt-2">
            <pre class="small mb-0"><code>
picasso:
    placeholders:
        blur:
            type: transformer
            size: 10
            blur: 5
            quality: 30
        blurhash:
            type: blurhash
            driver: gd
    default_placeholder: blur</code></pre>
            </twig:CodePanel>
        </details>

        <h2 id="twig-functions">Twig functions</h2>
        <p>
            The component is not the only way in. <code>picasso_image()</code> renders the same
            <code>&lt;picture&gt;</code> for projects without <code>symfony/ux-twig-component</code>, and
            <code>picasso_image_url()</code> returns a single transformed URL, for anything that is not an
            <code>&lt;img&gt;</code>: a CSS background, an Open Graph image, an email.
        </p>
        <div class="row row-cols-1 row-cols-md-2 mb-4">
            <div class="col mb-3 d-flex flex-column">
                <twig:Showcase class="flex-grow-1" meta="picasso_image()">
                    {{ picasso_image(
                        src: asset('build/images/elvira-visser-k89j1SUqf5U-unsplash.jpg'),
                        width: 600,
                        height: 400,
                        sizes: '(max-width: 768px) 100vw, 50vw',
                        fit: 'cover',
                        attributes: {alt: 'Rendered by picasso_image()', class: 'd-block w-100'},
                    ) }}
                    <twig:Showcase:Caption title="picasso_image()">The same <code>&lt;picture&gt;</code>, without the Twig component.</twig:Showcase:Caption>
                    <twig:block name="code"><pre class="small h-100 mb-0 rounded-0"><code>{% apply escape %}{% verbatim %}{{ picasso_image(
    src: asset('build/images/elvira-visser-k89j1SUqf5U-unsplash.jpg'),
    width: 600,
    height: 400,
    sizes: '(max-width: 768px) 100vw, 50vw',
    fit: 'cover',
    attributes: {alt: 'Rendered by picasso_image()', class: 'd-block w-100'},
) }}{% endverbatim %}{% endapply %}</code></pre></twig:block>
                </twig:Showcase>
            </div>
            <div class="col mb-3 d-flex flex-column">
                <twig:Showcase class="flex-grow-1" meta="picasso_image_url()">
                    <div class="d-flex align-items-end p-4" style="aspect-ratio: 3 / 2; background: linear-gradient(to top, rgb(0 0 0 / 0.65), transparent 55%), center / cover no-repeat url({{ picasso_image_url(asset('build/images/elvira-visser-k89j1SUqf5U-unsplash.jpg'), width: 1200, height: 800, format: 'webp', quality: 80, fit: 'cover')|json_encode }})">
                        <span class="h3 mb-0 text-white">Text over a transformed background</span>
                    </div>
                    <twig:Showcase:Caption title="picasso_image_url()">
                        One transformed URL, here as a CSS background. This page's <code>og:image</code> comes from it too:
                        a 1200x630 JPEG, the size social networks expect.
                    </twig:Showcase:Caption>
                    <twig:block name="code"><pre class="small h-100 mb-0 rounded-0"><code>{% apply escape %}{% verbatim %}<div style="background-image: url('{{ picasso_image_url(
    asset('build/images/elvira-visser-k89j1SUqf5U-unsplash.jpg'),
    width: 1200, height: 800, format: 'webp', quality: 80, fit: 'cover'
) }}')">

<meta property="og:image" content="{{ absolute_url(picasso_image_url(
    asset('build/images/jacalyn-beales-669247-unsplash.jpg'),
    width: 1200, height: 630, format: 'jpg', fit: 'cover'
)) }}">{% endverbatim %}{% endapply %}</code></pre></twig:block>
                </twig:Showcase>
            </div>
        </div>

        <h2 id="json-api">JSON API for headless frontends</h2>
        <p>
            When a React, Vue or mobile app renders the image itself, <code>ImageHelperInterface::imageData()</code>
            returns everything the component would: format sources, srcsets, placeholder and dimensions.
            The object is <code>JsonSerializable</code>, so a controller returns it as is:
            <a href="{{ path('picasso_api_image') }}"><code>{{ path('picasso_api_image') }}</code></a>.
        </p>
        <div class="row mb-4">
            <div class="col-lg-6 mb-3 d-flex flex-column">
                <twig:CodePanel title="Controller" meta="PHP" class="flex-grow-1">
                    <pre class="small mb-0"><code>{% apply escape %}{% verbatim %}#[Route(path: '/picasso/api/image.json', name: 'picasso_api_image')]
public function apiImage(ImageHelperInterface $imageHelper, Packages $packages): JsonResponse
{
    return new JsonResponse($imageHelper->imageData(
        src: $packages->getUrl('build/images/elvira-visser-k89j1SUqf5U-unsplash.jpg'),
        width: 1200,
        height: 800,
        sizes: '100vw',
        fit: 'cover',
    ));
}{% endverbatim %}{% endapply %}</code></pre>
                </twig:CodePanel>
            </div>
            <div class="col-lg-6 mb-3 d-flex flex-column">
                <twig:CodePanel title="Response" meta="application/json" class="flex-grow-1">
                    <pre class="small mb-0" style="max-height: 24rem"><code>{{ apiExample|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES')) }}</code></pre>
                </twig:CodePanel>
            </div>
        </div>

        <h2 id="overrides">Individual overrides</h2>
        <p>
            Per-image overrides: a custom quality, no placeholder, and the original file served as is with
            <code>unoptimized</code>, for what must not be transformed (an SVG logo, an animated GIF).
        </p>
        {% set overrides = [
            {title: 'Quality set to 40%', meta: 'quality: 40', metaColor: 'warning', props: {width: 600, height: 400, quality: 40, fit: 'cover', alt: 'Low quality', class: 'd-block w-100'}},
            {title: 'No placeholder', meta: 'placeholder: false', metaColor: 'secondary', props: {width: 600, height: 400, placeholder: false, fit: 'cover', alt: 'No placeholder', class: 'd-block w-100'}},
            {title: 'Original file, unoptimized', meta: 'unoptimized', metaColor: 'success', props: {width: 600, height: 400, unoptimized: true, alt: 'Unoptimized', class: 'd-block w-100'}},
        ] %}
        <div class="row row-cols-1 row-cols-md-3 mb-4">
            {% for override in overrides %}
                <div class="col mb-3 d-flex flex-column">
                    {% set markup = picasso.image('diana-parkhouse-1166627-unsplash.jpg', override.props) %}
                    {% set code = picasso.snippet('diana-parkhouse-1166627-unsplash.jpg', override.props) %}
                    <twig:Showcase class="flex-grow-1" meta="{{ override.meta }}" metaColor="{{ override.metaColor }}">
                        {{ markup }}
                        <twig:Showcase:Caption title="{{ override.title }}" />
                        <twig:block name="code">{{ code }}</twig:block>
                    </twig:Showcase>
                </div>
            {% endfor %}
        </div>

        <h2 id="generated-html">What the component generates</h2>
        <p>
            A single Twig tag, and the HTML it renders: one <code>&lt;source&gt;</code> per modern format,
            a JPEG fallback, a <code>srcset</code> capped to the source size (no upscaling), the placeholder,
            lazy loading and the dimensions that prevent layout shifts. All signed, all cached.
        </p>
        {% set props = {width: 600, height: 400, sizes: '(max-width: 768px) 100vw, 50vw', fit: 'cover', alt: 'A kitten', class: 'd-block w-100'} %}
        {% set generated = picasso.image('diana-parkhouse-1166627-unsplash.jpg', props) %}
        <div class="row mb-4">
            <div class="col-md-4 mb-3 d-flex flex-column">
                {% set code = picasso.snippet('diana-parkhouse-1166627-unsplash.jpg', props) %}
                <twig:Showcase class="flex-grow-1" active="code">
                    {{ generated }}
                    <twig:block name="code">{{ code }}</twig:block>
                </twig:Showcase>
            </div>
            <div class="col-md-8 mb-3 d-flex flex-column">
                <twig:CodePanel title="Generated HTML" meta="Signed, cached" class="flex-grow-1">
                    <pre class="small mb-0" style="max-height: 24rem"><code>{{ generated|split('\n')|map(line => line|split(' ')|filter(part => part is not empty)|join(' '))|filter(line => line is not empty)|map(line => line starts with '<' ? line : '    ' ~ line)|join('\n') }}</code></pre>
                </twig:CodePanel>
            </div>
        </div>

        <div class="alert alert-info">
            <strong>See also:</strong> the legacy version of this page, which uses Glide directly
            (no PicassoBundle on top), is still available at <a href="{{ path('images') }}">/images</a>.
            Handy for comparing how much Twig code you actually need between the two approaches.
        </div>
    </div>
{% endblock %}
