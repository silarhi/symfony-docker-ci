<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="turbo-prefetch" content="false">
    <meta name="x-app-version" content="{{ app_version }}" data-turbo-track="reload">
    <title>{% block title %}Welcome!{% endblock %}</title>
    {% block meta %}{% endblock %}
    <link rel="icon" href="{{ asset('favicon.ico') }}">
    <link rel="apple-touch-icon" href="{{ asset('apple-touch-icon.png') }}">

    {# Before the stylesheets, so the page never flashes in the other theme: the saved choice (theme_controller), else
       the system one. Turbo keeps the <html> attributes, and does not run this script again on its visits #}
    <script>
        (() => {
            let theme = null
            try {
                theme = localStorage.getItem('theme')
            } catch {}
            const dark = theme ? 'dark' === theme : matchMedia('(prefers-color-scheme: dark)').matches
            document.documentElement.setAttribute('data-bs-theme', dark ? 'dark' : 'light')
        })()
    </script>

    {{ reprise_entry_link_tags('app') }}
    {% block stylesheets %}{% endblock %}
    {{ reprise_entry_script_tags('app') }}
    {% block javascripts %}{% endblock %}

    {# Umami (self-hosted, cookieless): page views only, prod only, once the website id is set (UMAMI_WEBSITE_ID);
       data-domains keeps other hosts out of the stats. Loaded from the site's own origin, so ad blockers do not drop
       it as a third-party analytics host: the host's Traefik hands /a/script.js and /a/api/send (where the script
       posts, next to itself) to Umami #}
    {% if app.environment == 'prod' and umami_website_id %}
        <script defer src="/a/script.js" data-website-id="{{ umami_website_id }}" data-domains="labs.silarhi.fr"></script>
    {% endif %}
</head>
<body>
<nav class="navbar navbar-expand-md" data-bs-theme="dark">
    <div class="container">
        <a class="navbar-brand gap-2" href="{{ path('homepage') }}">
            App Demo
            <span class="badge badge-version">v{{ app_version }}</span>
        </a>
        {# Next to the menu button on mobile, after the menu on desktop #}
        <div class="d-flex align-items-center gap-1 ms-auto ms-md-2 order-md-last">
            <button type="button" class="btn-theme-toggle" aria-label="Dark mode" aria-pressed="false" {{ stimulus_controller('theme') }} {{ stimulus_action('theme', 'toggle') }}>
                <span class="theme-icon theme-icon-moon">{{ ux_icon('lucide:moon') }}</span>
                <span class="theme-icon theme-icon-sun">{{ ux_icon('lucide:sun') }}</span>
            </button>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu" aria-controls="navbar-menu" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>
        {% set routeName = app.request.attributes.get('_route') %}
        <div class="collapse navbar-collapse" id="navbar-menu">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link {{ routeName == 'homepage' ? 'active' }}" href="{{ path('homepage') }}">CI Demo</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ routeName == 'images' ? 'active' }}" href="{{ path('images') }}">Images</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ routeName == 'picasso' ? 'active' }}" href="{{ path('picasso') }}">Picasso</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ routeName == 'icons' ? 'active' }}" href="{{ path('icons') }}">Icons</a>
                </li>
                {# A block, so the 5xx error pages can leave it out: is_granted() reads the session, which may be what failed #}
                {% block navbar_account %}
                    {% if is_granted(constant('\\App\\EventSubscriber\\DoubleAuthentificationSubscriber::ROLE_2FA_SUCCEED')) %}
                        <li class="nav-item">
                            <a class="nav-link {{ routeName == 'app_security_authentification_protected' ? 'active' }}" href="{{ path('app_security_authentification_protected') }}">
                                Secret page!
                            </a>
                        </li>
                    {% else %}
                        <li class="nav-item">
                            <a class="nav-link {{ routeName == 'app_login' ? 'active' }}" href="{{ path('app_login') }}">Connection</a>
                        </li>
                    {% endif %}
                    {% if is_granted('ROLE_USER') %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('_logout_main') }}">
                                Logout
                            </a>
                        </li>
                    {% endif %}
                {% endblock %}
            </ul>
        </div>
    </div>
</nav>
<main>{% block body %}{% endblock %}</main>
<footer class="site-footer">
    <div class="container d-flex flex-column flex-md-row align-items-center justify-content-between gap-2">
        <ul class="list-inline mb-0 font-monospace small text-center text-md-start">
            <li class="list-inline-item">
                Git commit:
                <a href="https://github.com/silarhi/symfony-docker-ci/commit/{{ git_commit }}">{{ git_commit }}</a>
            </li>
            <li class="list-inline-item">
                App version: <span class="badge badge-version">{{ app_version }}</span>
            </li>
            <li class="list-inline-item">
                Symfony version:
                <span class="badge badge-version">{{ constant('Symfony\\Component\\HttpKernel\\Kernel::VERSION') }}</span>
            </li>
            <li class="list-inline-item">
                PHP version:
                <span class="badge badge-version">{{ php_version }}</span>
            </li>
        </ul>
        <a class="small" href="https://sainthillier.fr">Guillaume Sainthillier - PHP Web Developer</a>
    </div>
</footer>
</body>
</html>
