{% extends 'base.html.twig' %}

{% block title %}Page for connected users!{% endblock %}

{% block body %}
    <div class="container my-5">
        <div class="mx-auto text-center" style="max-width: 640px">
            <twig:StatusBar label="Authenticated" class="justify-content-center mb-4">
                <twig:StatusBar:Item label="Role">ROLE_2FA_SUCCEED</twig:StatusBar:Item>
            </twig:StatusBar>
            <h1 class="display-6 fw-bold">Success!</h1>
            <p class="lead text-secondary mb-4">Only connected users can see this mega secret message.</p>

            <div class="card dossier text-start mb-4">
                <div class="card-header">
                    <div>
                        <div class="label-mono text-secondary">Dossier classifié</div>
                        <strong>N° 7 S.G.</strong>
                    </div>
                    <span class="dossier-stamp">Confidentiel</span>
                </div>
                <div class="ratio ratio-16x9">
                    <iframe src="https://giphy.com/embed/xT1XGRazAbrOJnNu9i" frameBorder="0" class="giphy-embed" allowFullScreen title="Secret message"></iframe>
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center small">
                    <span class="text-secondary">{{ ux_icon('lucide:lock', {class: 'me-1'}) }}Restricted access</span>
                    <a href="https://giphy.com/gifs/xT1XGRazAbrOJnNu9i" target="_blank" rel="noopener">
                        GIPHY {{ ux_icon('lucide:external-link', {class: 'ms-1'}) }}
                    </a>
                </div>
            </div>

            <a class="btn btn-lg" href="{{ path('homepage') }}" role="button">
                {{ ux_icon('lucide:arrow-left', {class: 'me-1'}) }} Go back to home
            </a>
        </div>
    </div>
{% endblock %}
