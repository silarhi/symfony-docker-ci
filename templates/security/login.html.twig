{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}

    {% if error %}
        <div class="alert alert-danger">
            <div class="container px-0">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        </div>
    {% endif %}

    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <twig:StatusBar label="Firewall: main" status="primary" class="mb-3">
                    <twig:StatusBar:Item label="Step">1 / 2</twig:StatusBar:Item>
                </twig:StatusBar>
                <form method="post">
                    <div class="card">
                        <div class="card-header">
                            <h1 class="card-title">Login</h1>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label" for="inputUsername">Username</label>
                                <input type="text" value="test" name="username" id="inputUsername"
                                       class="form-control form-control-lg" required autofocus placeholder="test">
                            </div>
                            <div class="mb-4">
                                <label class="form-label" for="inputPassword">Password</label>
                                <div class="input-group input-group-flat" {{ stimulus_controller('password-visibility') }}>
                                    <input type="password" name="password" id="inputPassword"
                                           class="form-control form-control-lg" required placeholder="test" value="test"
                                           {{ stimulus_target('password-visibility', 'input') }}>
                                    <span class="input-group-text">
                                        <button type="button" class="btn btn-link link-secondary p-0" aria-label="Show the password" aria-pressed="false"
                                                {{ stimulus_action('password-visibility', 'toggle') }}>
                                            <span {{ stimulus_target('password-visibility', 'show') }}>{{ ux_icon('lucide:eye') }}</span>
                                            <span class="d-none" {{ stimulus_target('password-visibility', 'hide') }}>{{ ux_icon('lucide:eye-off') }}</span>
                                        </button>
                                    </span>
                                </div>
                            </div>

                            <input type="hidden"
                                   name="_csrf_token"
                                   data-controller="csrf-protection"
                                   value="{{ csrf_token('authenticate') }}"
                            >

                            {#
                            Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
                            See https://symfony.com/doc/current/security/remember_me.html

                            <div class="checkbox mb-3">
                                <label>
                                    <input type="checkbox" name="_remember_me"> Remember me
                                </label>
                            </div>
                            #}

                            <button class="btn btn-lg btn-primary w-100" type="submit">
                                Connection
                            </button>
                        </div>
                        <div class="card-footer text-secondary small">
                            Demo account: <code>test</code> / <code>test</code>. Two-factor authentication comes next.
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
