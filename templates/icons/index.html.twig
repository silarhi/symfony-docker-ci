{% extends 'base.html.twig' %}

{% block title %}UX Icons JS showcase{% endblock %}

{% block body %}
    <div class="container my-4">
        <div class="mb-5">
            <h1>UX Icons JS showcase</h1>
            <p class="lead">
                A live demo of <a href="https://github.com/silarhi/ux-icons-js-bundle" target="_blank" rel="noopener">silarhi/ux-icons-js-bundle</a>
                and its npm companion <a href="https://www.npmjs.com/package/@silarhi/ux-icons-js" target="_blank" rel="noopener">@silarhi/ux-icons-js</a>:
                the <a href="https://symfony.com/bundles/ux-icons/current/index.html" target="_blank" rel="noopener">Symfony UX Icons</a>
                of your Twig templates, in JavaScript, React and Vue. Everything is documented on
                <a href="https://ux-icons-js-bundle.silarhi.dev" target="_blank" rel="noopener">ux-icons-js-bundle.silarhi.dev</a>.
            </p>
            <p class="mb-0">
                On cache warmup, the bundle dumps the local icons of <code>assets/icons/</code> into <code>var/icons/</code>,
                one named export per icon, with the attributes <code>ux_icon()</code> gives them. The JavaScript side renders
                them without <code>innerHTML</code>. Switch any example to <em>Code</em> to see the code behind it.
            </p>
        </div>

        <nav class="mb-5" aria-label="Examples">
            <h2 class="h4">Examples</h2>
            <ol class="mb-0">
                <li><a href="#same-html">Same HTML as <code>ux_icon()</code></a></li>
                <li><a href="#configuration">The <code>ux_icons</code> configuration, reused</a></li>
                <li><a href="#vanilla">Vanilla JavaScript in a Stimulus controller</a></li>
                <li><a href="#react">React component</a></li>
                <li><a href="#dynamic-names">Icon names from an API</a></li>
                <li><a href="#attributes">Attributes, the <code>ux_icon()</code> way</a></li>
                <li><a href="#lock">A new icon in two steps</a></li>
            </ol>
        </nav>

        {# A string, not markup: printed |raw in the preview, escaped in the comparison below #}
        {% set twigIcon = ux_icon('lucide:trash-2', {class: 'text-danger', 'aria-label': 'Delete'}) %}
        <div {{ stimulus_controller('icons-compare', {twig: twigIcon ~ ''}) }}>
            <h2 id="same-html">Same HTML as <code>ux_icon()</code></h2>
            <p>
                The same icon with the same attributes, rendered three times: by Twig on the server, by vanilla
                JavaScript and by React in your browser.
            </p>
            <div class="row row-cols-1 row-cols-md-3 mb-3">
                <div class="col mb-3 d-flex flex-column">
                    <twig:Showcase class="flex-grow-1">
                        <div class="card-body text-center fs-1">{{ twigIcon|raw }}</div>
                        <div class="card-footer text-center text-muted small">Twig, <code>ux_icon()</code></div>
                        <twig:block name="code">
                            <pre class="small h-100 mb-0 rounded-0"><code>{% apply escape %}{% verbatim %}{{ ux_icon('lucide:trash-2', {
    class: 'text-danger',
    'aria-label': 'Delete',
}) }}{% endverbatim %}{% endapply %}</code></pre>
                        </twig:block>
                    </twig:Showcase>
                </div>
                <div class="col mb-3 d-flex flex-column">
                    <twig:Showcase class="flex-grow-1">
                        <div class="card-body text-center fs-1" {{ stimulus_target('icons-compare', 'preview') }}></div>
                        <div class="card-footer text-center text-muted small">JavaScript, <code>createIconElement()</code></div>
                        <twig:block name="code">
                            <pre class="small h-100 mb-0 rounded-0"><code>{% apply escape %}{% verbatim %}import { createIconElement } from '@silarhi/ux-icons-js'
import { LucideTrash2Icon } from '@icons/index.js'

element.append(createIconElement(LucideTrash2Icon, {
    class: 'text-danger',
    'aria-label': 'Delete',
}))
{% endverbatim %}{% endapply %}</code></pre>
                        </twig:block>
                    </twig:Showcase>
                </div>
                <div class="col mb-3 d-flex flex-column">
                    <twig:Showcase class="flex-grow-1">
                        <div class="card-body text-center fs-1" {{ stimulus_controller('icons-react', {component: 'Trash'}) }}></div>
                        <div class="card-footer text-center text-muted small">React, <code>&lt;UXIcon&gt;</code></div>
                        <twig:block name="code">
                            <pre class="small h-100 mb-0 rounded-0"><code>{% apply escape %}{% verbatim %}import { UXIcon } from '@silarhi/ux-icons-js/react'
import { LucideTrash2Icon } from '@icons/index.js'

<UXIcon
    icon={LucideTrash2Icon}
    className="text-danger"
    aria-label="Delete"
/>
{% endverbatim %}{% endapply %}</code></pre>
                        </twig:block>
                    </twig:Showcase>
                </div>
            </div>
            <p>
                Not just the same look: the same markup. <code>renderIcon()</code> returns the icon as an HTML string,
                compared below with the one <code>ux_icon()</code> rendered on the server.
            </p>
            <div class="card mb-5">
                <div class="card-header">
                    <h3 class="card-title">The two outputs</h3>
                    <div class="card-actions">
                        <span class="badge" {{ stimulus_target('icons-compare', 'result') }}>Comparing…</span>
                    </div>
                </div>
                <div class="card-body">
                    <h4 class="small text-muted">Twig, <code>ux_icon()</code>, on the server</h4>
                    <pre class="small text-wrap text-break"><code>{{ twigIcon }}</code></pre>
                    <h4 class="small text-muted">JavaScript, <code>renderIcon()</code>, in your browser</h4>
                    <pre class="small text-wrap text-break mb-0"><code {{ stimulus_target('icons-compare', 'javascript') }}></code></pre>
                </div>
            </div>
        </div>

        <h2 id="configuration">The <code>ux_icons</code> configuration, reused</h2>
        <p>
            Nothing to repeat for JavaScript: the bundle reads the <code>ux_icons</code> configuration and dumps each
            icon with its attributes already resolved. Here, <code>width</code>, <code>height</code> and
            <code>fill</code> come from <code>default_icon_attributes</code>, the <code>icon-lucide</code> class from the
            Lucide icon set, and the <code>delete</code> alias adds a <code>DeleteIcon</code> export.
        </p>
        <div class="row row-cols-1 row-cols-lg-2 mb-5">
            <div class="col mb-3 d-flex flex-column">
                <div class="card flex-grow-1">
                    <div class="card-header"><h3 class="card-title"><code>config/packages/ux_icons.yaml</code></h3></div>
                    <pre class="small h-100 mb-0 rounded-0"><code>{% verbatim %}ux_icons:
    default_icon_attributes:
        fill: currentColor
        height: '1em'
        width: '1em'

    icon_sets:
        lucide:
            icon_attributes:
                class: 'icon-lucide'

    aliases:
        delete: 'lucide:trash-2'{% endverbatim %}</code></pre>
                </div>
            </div>
            <div class="col mb-3 d-flex flex-column">
                <div class="card flex-grow-1">
                    <div class="card-header"><h3 class="card-title"><code>var/icons/index.js</code>, as dumped</h3></div>
                    <pre class="small h-100 mb-0 rounded-0 text-wrap text-break"><code>{{ dumpExample ?? 'Run bin/console ux-icons-js:dump' }}</code></pre>
                </div>
            </div>
        </div>

        <h2 id="vanilla">Vanilla JavaScript in a Stimulus controller</h2>
        <p>
            A copy button: Twig renders its icon with <code>ux_icon()</code>, and the Stimulus controller swaps it for a
            check mark once the command is copied. <code>createIconElement()</code> builds the <code>&lt;svg&gt;</code>
            with the DOM API: no HTML is parsed, which suits a strict Content Security Policy.
        </p>
        <twig:Showcase class="mb-5">
            <div class="card-body">
                <div class="input-group" {{ stimulus_controller('icons-copy', {text: 'composer require silarhi/ux-icons-js-bundle'}) }}>
                    <input type="text" class="form-control font-monospace" value="composer require silarhi/ux-icons-js-bundle" readonly aria-label="Command" {{ stimulus_target('icons-copy', 'input') }}>
                    <button type="button" class="btn" {{ stimulus_action('icons-copy', 'copy') }} aria-label="Copy the command">
                        <span class="d-inline-flex" {{ stimulus_target('icons-copy', 'icon') }}>{{ ux_icon('lucide:copy') }}</span>
                    </button>
                </div>
            </div>
            <twig:block name="code">
                <pre class="small h-100 mb-0 rounded-0"><code>{% apply escape %}{% verbatim %}import { Controller } from '@hotwired/stimulus'
import { createIconElement } from '@silarhi/ux-icons-js'
import { LucideCheckIcon, LucideCopyIcon } from '@icons/index.js'

export default class extends Controller {
    static targets = ['icon']
    static values = { text: String }

    async copy() {
        await navigator.clipboard.writeText(this.textValue)

        this.iconTarget.replaceChildren(createIconElement(LucideCheckIcon, { class: 'text-success' }))
        setTimeout(() => this.iconTarget.replaceChildren(createIconElement(LucideCopyIcon)), 2000)
    }
}{% endverbatim %}{% endapply %}</code></pre>
            </twig:block>
        </twig:Showcase>

        <h2 id="react">React component</h2>
        <p>
            <code>UXIcon</code> renders the SVG body as React elements, without <code>dangerouslySetInnerHTML</code>.
            Its props follow the <code>ux_icon()</code> rules, event handlers and refs are passed to React as they are.
            Only the imported star ends up in the bundle: the other icons of the dump are tree-shaken.
        </p>
        <twig:Showcase class="mb-5">
            <div class="card-body" {{ stimulus_controller('icons-react', {component: 'Rating', props: {max: 5}}) }}></div>
            <twig:block name="code">
                <pre class="small h-100 mb-0 rounded-0"><code>{% apply escape %}{% verbatim %}import { UXIcon } from '@silarhi/ux-icons-js/react'
import { useState } from 'react'
import { LucideStarIcon } from '@icons/index.js'

export default function Rating({ max = 5 }) {
    const [rating, setRating] = useState(3)

    return Array.from({ length: max }, (_, index) => (
        <button
            key={index}
            type="button"
            aria-label={`Rate ${index + 1} out of ${max}`}
            onClick={() => setRating(index + 1)}
        >
            <UXIcon icon={LucideStarIcon} className={index < rating ? 'text-yellow' : 'text-muted'} />
        </button>
    ))
}{% endverbatim %}{% endapply %}</code></pre>
            </twig:block>
        </twig:Showcase>

        <h2 id="dynamic-names">Icon names from an API</h2>
        <p>
            Named imports need the icon name when you write the code. Here, the names come from
            <a href="{{ path('icons_api_status') }}">a JSON API</a>: <code>UXLazyIcon</code> loads each icon by its name,
            alone, from the dumped <code>loaders</code> map, and shows a fallback meanwhile. Open the network tab of your
            dev tools: every icon is its own small chunk. The last name is unknown to the dump, so its fallback stays.
        </p>
        <twig:Showcase class="mb-5">
            <div {{ stimulus_controller('icons-react', {component: 'StatusBoard', props: {url: path('icons_api_status')}}) }}></div>
            <twig:block name="code">
                <pre class="small h-100 mb-0 rounded-0"><code>{% apply escape %}{% verbatim %}import { UXLazyIcon } from '@silarhi/ux-icons-js/react'
import { loaders } from '@icons/loaders.js'

// [{ "label": "Web servers", "icon": "lucide:server", "status": "Operational", ... }, ...]
const services = await (await fetch('/icons/api/status.json')).json()

services.map(({ label, icon }) => (
    <li key={label}>
        <UXLazyIcon name={icon} loaders={loaders} fallback={<span className="placeholder" />} />
        {label}
    </li>
))

// Without React: const icon = await loadIcon(loaders, name) // null for an unknown name{% endverbatim %}{% endapply %}</code></pre>
            </twig:block>
        </twig:Showcase>

        <h2 id="attributes">Attributes, the <code>ux_icon()</code> way</h2>
        <p>
            The attributes given in JavaScript are merged with the dumped ones following the <code>ux_icon()</code>
            rules: <code>aria-hidden="true"</code> unless the icon has a text alternative, token lists for
            <code>class</code>, <code>null</code> to remove an attribute, JSON for <code>data-*</code>. The right column is
            computed by <code>resolveIcon()</code> in your browser (<code>xmlns</code> and <code>viewBox</code> left out).
        </p>
        <div class="card mb-5">
            <div class="table-responsive">
                <table class="table table-vcenter card-table mb-0" {{ stimulus_controller('icons-attributes') }}>
                    <thead>
                        <tr>
                            <th>Attributes given to <code>LucideHeartIcon</code></th>
                            <th>Resulting <code>&lt;svg&gt;</code> attributes</th>
                        </tr>
                    </thead>
                    <tbody {{ stimulus_target('icons-attributes', 'body') }}></tbody>
                </table>
            </div>
        </div>

        <h2 id="lock">A new icon in two steps</h2>
        <p>
            Write the import first, then run <code>ux:icons:lock</code>: the bundle finds the icons imported in your
            JavaScript files, <code>symfony/ux-icons</code> downloads them from Iconify, and they are dumped again.
        </p>
        <div class="row row-cols-1 row-cols-lg-2 mb-4">
            <div class="col mb-3 d-flex flex-column">
                <div class="card flex-grow-1">
                    <div class="card-header"><h3 class="card-title">1. Import it</h3></div>
                    <pre class="small h-100 mb-0 rounded-0"><code>{% verbatim %}// assets/js/controllers/mail_controller.js
import { LucideMailIcon } from '@icons/index.js'{% endverbatim %}</code></pre>
                </div>
            </div>
            <div class="col mb-3 d-flex flex-column">
                <div class="card flex-grow-1">
                    <div class="card-header"><h3 class="card-title">2. Lock it</h3></div>
                    <pre class="small h-100 mb-0 rounded-0"><code>{% verbatim %}$ php bin/console ux:icons:lock
 ✓ Imported lucide:mail (License: ISC). Render with: {{ ux_icon('lucide:mail') }}
 JavaScript: import { LucideMailIcon }
 // Dumped 16 icon(s) for JavaScript.{% endverbatim %}</code></pre>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ reprise_entry_script_tags('icons') }}
{% endblock %}
