{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "entry": [
        "assets/js/app.js",
        "assets/js/pages/**/*.{js,jsx}",
        "assets/js/controllers/**/*.{js,jsx}"
    ],
    "project": [
        "assets/**/*.{js,jsx,ts,tsx}"
    ],
    "paths": {
        "@/*": [
            "assets/*"
        ]
    },
    "ignoreBinaries": [
        "composer",
        "vendor/bin/.+"
    ],
    "rules": {
        "unlisted": "off",
        "unresolved": "off"
    },
    "ignoreDependencies": [
        "@tabler/core",
        "@hotwired/turbo",
        "^@symfony/ux-"
    ]
}
