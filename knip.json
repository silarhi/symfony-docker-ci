{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "entry": [
        "assets/js/pages/**/*.{ts,tsx}",
        "assets/js/controllers/**/*.{ts,tsx}"
    ],
    "project": [
        "assets/**/*.{js,jsx,ts,tsx}"
    ],
    "ignore": [
        "assets/js/icons/**"
    ],
    "paths": {
        "@/*": [
            "assets/*"
        ]
    },
    "ignoreBinaries": [
        "composer"
    ],
    "rules": {
        "unlisted": "off",
        "unresolved": "off"
    },
    "ignoreDependencies": [
        "@hotwired/turbo",
        "^@symfony/ux-"
    ]
}
