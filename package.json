{
    "license": "MIT",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "dev": "vite build --mode development",
        "watch": "vite build --mode development --watch",
        "dev-server": "vite",
        "build": "vite build",
        "prepare": "husky",
        "lint": "biome check --write assets",
        "lint-ci": "biome check assets",
        "prettier": "prettier --write --no-error-on-unmatched-pattern \"assets/**/*.{md,yaml,yml}\"",
        "format": "pnpm lint && pnpm prettier",
        "knip": "knip",
        "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,mjs,json,scss}": "biome check --write --no-errors-on-unmatched",
        "*.{md,yaml,yml}": "prettier --write",
        "*.php": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "*.twig": "vendor/bin/twig-cs-fixer lint --fix --config=.twig-cs-fixer.php",
        "composer.json": "composer normalize"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.3",
        "@fullhuman/postcss-purgecss": "^8.0.0",
        "@hotwired/stimulus": "^3.2.2",
        "@hotwired/turbo": "^8.0.23",
        "@silarhi/ux-icons-js": "^0.3.1",
        "@symfony/reprise": "^1.3.0",
        "@symfony/ux-turbo": "file:vendor/symfony/ux-turbo/assets",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "husky": "^9.1.7",
        "knip": "^6.41.0",
        "lint-staged": "^17.6.0",
        "postcss": "^8.5.30",
        "prettier": "^3.9.10",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "sass": "^1.105.2",
        "typescript": "^7.0.2",
        "vite": "^8.3.4"
    },
    "dependencies": {
        "@tabler/core": "^1.7.0"
    },
    "packageManager": "pnpm@12.15.0"
}
