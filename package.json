{
    "license": "MIT",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "dev": "vite build --mode development",
        "watch": "vite build --mode development --watch",
        "dev-server": "vite",
        "build": "vite build",
        "prepare": "husky",
        "lint": "biome check --write assets",
        "lint-ci": "biome check assets",
        "prettier": "prettier --write \"assets/**/*.{scss,md}\"",
        "format": "yarn lint && yarn prettier",
        "knip": "knip"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,mjs,json}": "biome check --write --no-errors-on-unmatched",
        "*.{scss,md,yaml,yml}": "prettier --write",
        "*.php": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "*.twig": "vendor/bin/twig-cs-fixer lint --fix --config=.twig-cs-fixer.php",
        "composer.json": "composer normalize"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@fullhuman/postcss-purgecss": "^8.0.0",
        "@hotwired/stimulus": "^3.2.2",
        "@hotwired/turbo": "^8.0.23",
        "@symfony/reprise": "^1.3.0",
        "@symfony/ux-turbo": "file:vendor/symfony/ux-turbo/assets",
        "@vitejs/plugin-react": "^6.1.2",
        "husky": "^9.1.7",
        "knip": "^6",
        "lint-staged": "^17.6.0",
        "postcss": "^8.5.29",
        "prettier": "^3.9.9",
        "prop-types": "^15.8.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "sass": "^1.105.1",
        "vite": "^8.3.3"
    },
    "dependencies": {
        "@tabler/core": "^1.6.1"
    }
}
